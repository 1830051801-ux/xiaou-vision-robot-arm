# Copy this file to config.env on the Raspberry Pi.

# Camera.
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=15
CAMERA_WARMUP_FRAMES=3
CAMERA_OPEN_RETRIES=3
CAMERA_OPEN_RETRY_DELAY_S=0.6

# YOLO ONNX model.
YOLO_MODEL=xiaou_all.onnx
YOLO_IMAGE_SIZE=640
YOLO_CONF=0.35
YOLO_STRICT_TARGET=false
TARGET_OBJECTS=pen,cup,bottle
VISION_DEBUG=true

# STM32 UART.
SERIAL_PORT=/dev/serial0
SERIAL_BAUD=115200
SERIAL_PROTOCOL=binary
ENABLE_SERIAL=false

# Pixel-to-robot calibration. If runtime/calibration/workspace_homography.yaml
# exists, the homography file is used first.
PIXEL_ORIGIN_U=320
PIXEL_ORIGIN_V=240
PIXEL_TO_BASE_SCALE_X=0.50
PIXEL_TO_BASE_SCALE_Y=0.50
BASE_OFFSET_X_MM=200
BASE_OFFSET_Y_MM=0
WORKSPACE_X_MIN_MM=0
WORKSPACE_X_MAX_MM=500
WORKSPACE_Y_MIN_MM=-300
WORKSPACE_Y_MAX_MM=300
Z_SAFE_MM=80
Z_GRAB_MM=25
MIN_TARGET_AREA_RATIO=0.015
TARGET_FILTER_WINDOW=5
TARGET_STABLE_FRAMES=3
TARGET_TIMEOUT_S=7

# Gripper parameters used when building the coordinate grasp frame.
GRIPPER_OPEN_MARGIN_MM=15
GRIPPER_CLOSE_MARGIN_MM=8
GRIPPER_OPEN_MIN_MM=35
GRIPPER_OPEN_MAX_MM=95
GRIPPER_FORCE_PCT=60
