# XiaoU demo defaults.
# Safe to source from shell and loaded by Python dotenv.

ROBOT_NAME=XiaoU

# Camera
CAMERA_INDEX=0
CAMERA_WIDTH=320
CAMERA_HEIGHT=240
CAMERA_FPS=10
CAMERA_WARMUP_FRAMES=3
CAMERA_OPEN_RETRIES=3
CAMERA_OPEN_RETRY_DELAY_S=0.6

# Audio input/output
VOICE_SAMPLE_RATE=16000
RECORD_SECONDS=3.5
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
TTS_ENGINE=edge
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_PITCH=+0Hz
TTS_RATE=+0%
TTS_ALLOW_ROBOTIC_FALLBACK=false
ESPEAK_VOICE=zh
ESPEAK_SPEED=150

# Wakeword flow
WAKEWORD_ENABLED=true
WAKEWORD_REQUIRE_SECOND_STAGE=true
WAKEWORDS="小U,小优,xiao u"
WAKE_CHUNK_SECONDS=1.4
COMMAND_MAX_SECONDS=8
COMMAND_MIN_SECONDS=1
COMMAND_SILENCE_SECONDS=1.2
COMMAND_SILENCE_RMS=0.012
DEMO_IDLE_SLEEP_S=0.4

# YOLO OpenCV DNN
YOLO_MODEL=xiaou_objects_gpu_deep.onnx
YOLO_IMAGE_SIZE=640
YOLO_CONF=0.18
YOLO_STRICT_TARGET=false
VISION_DEBUG=true
TARGET_TIMEOUT_S=5
TARGET_FILTER_WINDOW=5
TARGET_STABLE_FRAMES=3
MIN_TARGET_AREA_RATIO=0.008
TARGET_OBJECTS="pen,cup,cola,bottle,earphone"
XIAOU_PROACTIVE_VISION=1
XIAOU_PROACTIVE_INTERVAL_S=35
XIAOU_PROACTIVE_COOLDOWN_S=75

# Robot safety / calibrated base coordinates
WORKSPACE_X_MIN_MM=160
WORKSPACE_X_MAX_MM=340
WORKSPACE_Y_MIN_MM=-310
WORKSPACE_Y_MAX_MM=-150
Z_SAFE_MM=50
Z_GRAB_MM=225

# Face display
FACE_WIDTH=360
FACE_HEIGHT=270
FACE_FULLSCREEN=false
FACE_SHOW_LABEL=false
FACE_DEBUG_BORDER=false
FACE_REMOVE_GREEN_BG=false
FACE_MAX_FRAMES=8
FACE_FRAME_STEP=4
XIAOU_OPEN_YOLO=0

# Cloud AI timeout. Keep short so the GUI does not look stuck.
AI_TIMEOUT_S=10

# Deskpet
DESKPET_TTS=true
DESKPET_FACE_ENABLED=false
FACE_GREET_COOLDOWN_S=8
FACE_GREET_MIN_AREA=6500
FACE_GREET_TEXT="Hello, I am XiaoU."
