# Copy this file to config.env on the Raspberry Pi.
# Start without AI_API_KEY first. The program has local keyword fallback.

# OpenAI-compatible chat API. Examples: DeepSeek, Aliyun Bailian, Zhipu, etc.
ROBOT_NAME=小U
AI_API_KEY=replace_with_your_api_key
AI_API_URL=https://api.deepseek.com/chat/completions
AI_MODEL=deepseek-chat
AI_TIMEOUT_S=10

# Baidu short speech recognition ASR.
# Create an app in Baidu AI Cloud Speech Recognition and fill these two values.
BAIDU_ASR_API_KEY=replace_with_baidu_api_key
BAIDU_ASR_SECRET_KEY=replace_with_baidu_secret_key
BAIDU_ASR_DEV_PID=1537
BAIDU_ASR_RATE=16000

# Camera. USB camera usually uses 0.
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=15
CAMERA_WARMUP_FRAMES=3
CAMERA_OPEN_RETRIES=3
CAMERA_OPEN_RETRY_DELAY_S=0.6

# YOLO model. 2GB Raspberry Pi uses OpenCV DNN + ONNX, no torch/ultralytics.
YOLO_MODEL=xiaou_all.onnx
YOLO_IMAGE_SIZE=640
YOLO_CONF=0.16
YOLO_STRICT_TARGET=false
VISION_DEBUG=true

# Only detect these object names from COCO model.
TARGET_OBJECTS="pen,cup,cola,bottle,earphone"
WAKEWORD_ENABLED=true
WAKEWORD_REQUIRE_SECOND_STAGE=true
WAKE_CHUNK_SECONDS=1.4
COMMAND_MAX_SECONDS=8
COMMAND_MIN_SECONDS=1
COMMAND_SILENCE_SECONDS=1.2
COMMAND_SILENCE_RMS=0.012
DEMO_IDLE_SLEEP_S=0.4

# Audio device selection for sounddevice. Leave blank to use system defaults.
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
VOICE_SAMPLE_RATE=16000
RECORD_SECONDS=5
ENABLE_DENOISE=true
FACE_WIDTH=320
FACE_HEIGHT=240
FACE_FULLSCREEN=false
FACE_SHOW_LABEL=true
FACE_DEBUG_BORDER=false
FACE_MAX_FRAMES=8
FACE_FRAME_STEP=4

# Temporary vision-to-robot coordinate config.
# Calibration will replace these rough values later.
PIXEL_ORIGIN_U=320
PIXEL_ORIGIN_V=240
PIXEL_TO_BASE_SCALE_X=0.50
PIXEL_TO_BASE_SCALE_Y=0.50
BASE_OFFSET_X_MM=200
BASE_OFFSET_Y_MM=0
WORKSPACE_X_MIN_MM=0
WORKSPACE_X_MAX_MM=500
WORKSPACE_Y_MIN_MM=-300
WORKSPACE_Y_MAX_MM=300
Z_SAFE_MM=80
Z_GRAB_MM=25
MIN_TARGET_AREA_RATIO=0.015
TARGET_FILTER_WINDOW=5
TARGET_STABLE_FRAMES=3
TARGET_TIMEOUT_S=7

# Gripper plan sent to MCU. Tune these after the real gripper is installed.
GRIPPER_OPEN_MARGIN_MM=15
GRIPPER_CLOSE_MARGIN_MM=8
GRIPPER_OPEN_MIN_MM=35
GRIPPER_OPEN_MAX_MM=95
GRIPPER_FORCE_PCT=60

# Text to speech. Used by scripts/run_cloud_chat.sh --voice
TTS_ENGINE=local
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=+0%
ESPEAK_VOICE=zh
ESPEAK_SPEED=150

